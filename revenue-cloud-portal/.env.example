# ---- Salesforce connection (server-side only; never exposed to the browser) ----

# My Domain URL of the DeepHealth org (used for the OAuth token call and all API calls)
SF_INSTANCE_URL=https://4c1753372963009-dev-ed.develop.my.salesforce.com

# Production: OAuth 2.0 Client Credentials of a Connected App / External Client App.
# The run-as user of that app needs access to QuoteRestController and the Product/Quote objects.
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Local development fallback: when SF_CLIENT_ID / SF_CLIENT_SECRET are empty the server
# borrows the Salesforce CLI session of this org (username or alias).
SF_CLI_ORG=keerthiusage@forcecloudlabs.com

# ---- Behaviour ----
SF_API_VERSION=v62.0
SF_CATALOG_NAME=DeepHealth Product Catalog
SF_CURRENCY=USD
# Tax added to the quote (the reference portal uses 18%). Applied server-side.
TAX_RATE=0.18
PORT=8787

# ---- Public hosting (Render sets these; see render.yaml) ----
# PUBLIC_MODE defaults to on when SF_CLIENT_ID/SF_CLIENT_SECRET are set, off for local CLI development.
# In public mode visitors can only open/update quotes they created, and requests are rate limited.
PUBLIC_MODE=
# Required in public mode: any random string of 16+ characters.
SESSION_SECRET=
